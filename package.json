{
  "name": "react-chat-gpt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently -n web,api -c blue,green \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "npm --prefix server test",
    "test:all": "npm run test && npm run test:server",
    "preview": "vite preview"
  },
  "dependencies": {
    "antd": "^5.20.6",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "hast-util-to-text": "^4.0.2",
    "i18next": "^23.15.1",
    "idb": "^8.0.0",
    "katex": "^0.17.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.441.0",
    "mermaid": "^11.16.0",
    "mobx": "^6.13.2",
    "mobx-react-lite": "^4.0.7",
    "pdfjs-dist": "^6.1.200",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.11",
    "unist-util-visit": "^5.1.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
