# 前端构建环境变量样例。复制为 .env.local 后按需修改（.env.local 不入库）。

# 数据来源开关：true = 纯前端演示（IndexedDB + mock，无需后端）；
# false = 对接真实后端（需先启动 server/，见 server/.env.example）
VITE_USE_LOCAL_DATA=true

# 后端服务地址（VITE_USE_LOCAL_DATA=false 时必填），
# 与 server 的 PORT / CORS_ORIGIN 配套
VITE_WEBUI_BASE_URL=http://localhost:3000

# 应用名（可选）
# VITE_APP_NAME=AI Chat

# 默认 LLM provider / 模型（可选；用户在设置弹窗里的选择始终优先）
# VITE_DEFAULT_LLM_PROVIDER=demo
# VITE_DEFAULT_LLM_MODEL=gpt-4o-mini
