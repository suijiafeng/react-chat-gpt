# =========================================================================
# React Chat GPT Environment Variables Template
# =========================================================================

# Application general name
VITE_APP_NAME=AI Chat

# Local Mock Mode / Client-side local data switch:
# Set 'true' to run fully offline on IndexedDB (default for demo/github pages).
# Set 'false' to connect to an external server.
VITE_USE_LOCAL_DATA=true

# Real backend API Endpoint (Only active when VITE_USE_LOCAL_DATA is false)
# For production/deployment, configure your webui server url.
VITE_WEBUI_BASE_URL=

# Default settings (can be overridden by user in the Settings Modal)
VITE_DEFAULT_LLM_PROVIDER=demo
VITE_DEFAULT_LLM_MODEL=gpt-4o-mini
